GITHUB_TOKEN=
GITHUB_REPO=owner/repo
CALLBACK_SECRET=
PUBLISH_PAT=
SERVER_URL=

# Slack Incoming Webhook — notifies channel when a publish PR is opened
SLACK_WEBHOOK_URL=
# Optional Slack member ID to @mention (e.g. U01234567)
SLACK_REVIEWER_USER_ID=

# For GitHub Actions publish.yml fallback — add the same URL as repo secret SLACK_WEBHOOK_URL
